[package]
name = "{{crate_prefix}}engine"
description = "{{product}}: the session, the command registry and the one dispatch"
version = "0.1.0"
edition = "2024"
publish = false

[package.metadata.swarm]
layer = "engine"

[dependencies]
{{crate_prefix}}backends = { path = "../backends" }
{{crate_prefix}}model = { path = "../model" }
schemars = { workspace = true }
serde = { workspace = true, features = ["derive"] }
serde_json = { workspace = true }
serde_path_to_error = { workspace = true }

[dev-dependencies]
{{crate_prefix}}testkit = { path = "../testkit" }
# `adversarial_params`, the hostile params a command is sent: pinned beside `swarm-core`.
swarm-core-testkit = { workspace = true }

[lints]
workspace = true
